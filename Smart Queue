          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- MODAL: TOKEN SUCCESS & LIVE PASS                                          -->
  <!-- ========================================================================= -->
  <div id="token-success-modal" class="modal-overlay" style="display: none;">
    <div class="modal-card glass-panel token-modal-card">
      <div class="token-pass-card">
        <div class="token-pass-head">
          <div class="pass-brand">
            <i data-lucide="activity"></i>
            <span>SMART QUEUE AI TOKEN PASS</span>
          </div>
          <div class="pass-date" id="pass-generated-date">Today</div>
        </div>

        <div class="token-pass-main">
          <div class="token-number-hero" id="modal-token-number">#TQ-104</div>
          <div class="token-subtitle">Priority Queue Token Confirmed</div>

          <div class="pass-details-grid">
            <div class="pass-cell">
              <label>Patient Name</label>
              <strong id="pass-patient-name">Alex Morgan</strong>
            </div>
            <div class="pass-cell">
              <label>Doctor</label>
              <strong id="pass-doctor-name">Dr. Sarah Mitchell</strong>
            </div>
            <div class="pass-cell">
              <label>Hospital</label>
              <strong id="pass-hospital-name">Apollo Care Hospital</strong>
            </div>
            <div class="pass-cell">
              <label>Estimated Wait</label>
              <strong class="text-accent" id="pass-wait-time">~15 Minutes</strong>
            </div>
            <div class="pass-cell">
              <label>Appointment Time</label>
              <strong id="pass-appointment-time">10:30 AM</strong>
            </div>
            <div class="pass-cell">
              <label>Payment</label>
              <strong class="text-success"><i data-lucide="check"></i> Verified UPI</strong>
            </div>
          </div>
        </div>

        <div class="token-pass-actions">
          <button class="btn-primary-gradient w-100" onclick="closeTokenModalAndTrack()">
            <i data-lucide="eye"></i> Track My Live Queue Position
          </button>
          <button class="btn-secondary-glass w-100 mt-10" onclick="window.print()">
            <i data-lucide="printer"></i> Print / Save Token
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Audio elements for feedback sound effects -->
  <audio id="audio-chime" preload="auto">
    <source src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" type="audio/mpeg">
  </audio>

  <!-- Google Translate Script (loads GT widget; calls googleTranslateElementInit) -->
  <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async defer></script>

  <!-- Firebase SDK (compat version — works with existing JS without module bundler) -->
  <script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-analytics-compat.js"></script>

  <!-- Lucide Icons (loaded here at bottom so HTML parses first, then icons render synchronously) -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Firebase Configuration (logic-legends-pro1 project) -->
  <script src="firebase-config.js"></script>

  <!-- Application Logic -->
  <script src="app.js"></script>

  <!-- Ensure Lucide icons render after deferred scripts load -->
  <script>
    window.addEventListener('load', function() {
      if (window.lucide) window.lucide.createIcons();
    });
  </script>

  <!-- Global Multi-Language System -->
  <script src="i18n.js"></script>
</body>
</html>
