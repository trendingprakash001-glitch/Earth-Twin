    // --- 3. SIMILARITY & SIMULATION ENGINES ---
    function calculateSimilarity(planetarySite, planet, analog) {
      const diffTemp = Math.abs(analog.tempMeanC - planetarySite.tempMeanC);
      const thermalScore = Math.max(0, Math.round(100 - diffTemp * 0.75));

      let pressureScore = 0;
      if (planet.id === 'venus' && planetarySite.elevationMeters > 50000) {
        pressureScore = Math.max(0, Math.round(100 - Math.abs(analog.surfacePressureMbar - 1013) * 0.1));
      } else {
        const p1 = Math.log10(Math.max(1e-12, analog.surfacePressureMbar));
        const p2 = Math.log10(Math.max(1e-12, planetarySite.pressureMbar));
        pressureScore = Math.max(0, Math.round((1 - Math.abs(p1 - p2) / (planet.id === 'moon' ? 12 : 5)) * 100));
      }

      const aridityScore = analog.annualPrecipitationMm < 5 ? 95 : analog.annualPrecipitationMm < 50 ? 80 : 50;
      const terrainScore = 85;
      const mineralScore = 70;
      const uvScore = analog.elevationMeters > 2000 ? 80 : 55;
      const elevScore = Math.min(100, Math.round((analog.elevationMeters / 4500) * 80 + 20));

      const paramScores = [
        { name: 'Thermal Envelope', score: thermalScore, earthValue: `${analog.tempMeanC}°C (swing ${analog.diurnalSwingC}°C)`, planetaryValue: `${planetarySite.tempMeanC}°C (swing ${planetarySite.diurnalSwingC}°C)` },
        { name: 'Atmospheric Pressure', score: pressureScore, earthValue: `${analog.surfacePressureMbar} mbar`, planetaryValue: `${planetarySite.pressureMbar} mbar` },
        { name: 'Aridity & Moisture', score: aridityScore, earthValue: `${analog.annualPrecipitationMm} mm/yr`, planetaryValue: '0 mm/yr' },
        { name: 'Terrain Morphology', score: terrainScore, earthValue: analog.terrainType, planetaryValue: planetarySite.geomorphology.split(',')[0] },
        { name: 'Mineralogy & Regolith', score: mineralScore, earthValue: analog.dominantMinerals.slice(0, 3).join(', '), planetaryValue: planetarySite.dominantMinerals.slice(0, 3).join(', ') },
        { name: 'UV & Solar Flux', score: uvScore, earthValue: `${analog.elevationMeters > 2000 ? 'High' : 'Moderate'} UV`, planetaryValue: 'Unattenuated' },
        { name: 'Pressure Altitude', score: elevScore, earthValue: `${analog.elevationMeters}m ASL`, planetaryValue: `${planetarySite.elevationMeters}m Datum` }
      ];

      const weights = [0.20, 0.15, 0.15, 0.15, 0.15, 0.10, 0.05];
      let weightedSum = 0;
      paramScores.forEach((p, idx) => {
        weightedSum += p.score * weights[idx];
      });

      return {
        planetId: planet.id,
        planetarySite,
        analogLocation: analog,
        overallScore: Math.min(98, Math.max(15, Math.round(weightedSum))),
        parameterScores: paramScores,
        calculatedAt: new Date().toISOString()
      };
    }

    function runMissionSimulation(vehicle, planetarySite, analog) {
      const tempUnderMin = Math.max(0, vehicle.tempOperatingRangeC.min - analog.tempMinC);
      const tempOverMax = Math.max(0, analog.tempMaxC - vehicle.tempOperatingRangeC.max);
      let thermalRisk = 'nominal';
      let thermalDetails = 'Nominal thermal operations. Ambient temperature within vehicle operating envelope.';

      if (tempUnderMin > 15 || tempOverMax > 15) {
        thermalRisk = 'critical';
        thermalDetails = `Critical Thermal Risk: Ambient temperatures (${analog.tempMinC}°C to ${analog.tempMaxC}°C) exceed vehicle limits. Subsystem freeze or overheat shutdown imminent without external conditioning.`;
      } else if (tempUnderMin > 0 || tempOverMax > 0) {
        thermalRisk = 'caution';
        thermalDetails = 'Thermal Caution: Ambient extremes approach boundary limits. Pre-heating or auxiliary active cooling cycles required.';
      }

      let terrainTractionRisk = 'nominal';
      let tractionDetails = 'Nominal terrain traction. Surface bearing capacity and slope profile suited for vehicle drive geometry.';

      if (analog.terrainType.includes('Basaltic')) {
        terrainTractionRisk = 'caution';
        tractionDetails = 'Caution: Abrasive jagged volcanic basalt can induce severe gash wear on aluminum/titanium wheels.';
      } else if (analog.terrainType.includes('Impact')) {
        terrainTractionRisk = 'caution';
        tractionDetails = 'Caution: Fractured impact breccia and boulder fields require autonomous hazard detection and visual odometry re-routing.';
      }

      let densityRatio = planetarySite.planetId === 'mars' ? 0.016 : planetarySite.planetId === 'moon' ? 0.0 : 0.85;

      let score = 88;
      if (thermalRisk === 'critical') score -= 30;
      else if (thermalRisk === 'caution') score -= 12;
      if (terrainTractionRisk === 'caution') score -= 10;
      if (planetarySite.planetId === 'moon' && vehicle.type === 'Coaxial Rotorcraft Drone') score = 15;
      score = Math.max(10, Math.min(98, score));

      return {
        vehicle,
        planetarySite,
        analogLocation: analog,
        compatibilityScore: score,
        thermalRisk,
        thermalDetails,
        terrainTractionRisk,
        tractionDetails,
        densityRatio,
        suitabilityVerdict: score > 80 ? 'HIGH ANALOG SUITABILITY' : score > 55 ? 'ACCEPTABLE WITH COMPENSATION' : 'POOR DIRECT FIT'
      };
    }

    // --- 4. 3D WEBGL GLOBE COMPONENT ---
    function Globe3D({ mode, pins = [], selectedPinId, height = 450 }) {
      const mountRef = useRef(null);
      const [autoRotate, setAutoRotate] = useState(true);

      useEffect(() => {
        if (!mountRef.current || !window.THREE) return;
        const container = mountRef.current;
        const width = container.clientWidth || 550;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
        camera.position.z = 2.8;

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.innerHTML = '';
        container.appendChild(renderer.domElement);

        const sunLight = new THREE.DirectionalLight(0xffffff, 1.8);
        sunLight.position.set(5, 3, 5);
        scene.add(sunLight);

        const ambientLight = new THREE.AmbientLight(0x38bdf8, 0.4);
        scene.add(ambientLight);

        // Procedural Planet Texture
        const canvas = document.createElement('canvas');
        canvas.width = 1024;
        canvas.height = 512;
        const ctx = canvas.getContext('2d');
        if (mode === 'earth') {
          const grad = ctx.createLinearGradient(0, 0, 0, 512);
          grad.addColorStop(0, '#020d24');
          grad.addColorStop(0.5, '#06204d');
          grad.addColorStop(1, '#020d24');
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, 1024, 512);
          ctx.fillStyle = '#1e3a29';
          for (let i = 0; i < 200; i++) {
            ctx.beginPath();
            ctx.arc(Math.random() * 1024, 75 + Math.random() * 360, 15 + Math.random() * 40, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.fillStyle = '#d4b483';
          for (let i = 0; i < 80; i++) {
            ctx.beginPath();
            ctx.arc(Math.random() * 1024, 150 + Math.random() * 200, 10 + Math.random() * 25, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.fillStyle = '#e2e8f0';
          ctx.fillRect(0, 0, 1024, 40);
          ctx.fillRect(0, 470, 1024, 42);
        } else if (mode === 'mars') {
          const grad = ctx.createLinearGradient(0, 0, 0, 512);
          grad.addColorStop(0, '#7c2d12');
          grad.addColorStop(0.5, '#b91c1c');
          grad.addColorStop(1, '#7c2d12');
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, 1024, 512);
          ctx.fillStyle = '#451a03';
          for (let i = 0; i < 180; i++) {
            ctx.beginPath();
            ctx.arc(Math.random() * 1024, 100 + Math.random() * 310, 20 + Math.random() * 60, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.fillStyle = '#f8fafc';
          ctx.fillRect(0, 0, 1024, 30);
          ctx.fillRect(0, 480, 1024, 32);
        } else if (mode === 'moon') {
          ctx.fillStyle = '#64748b';
          ctx.fillRect(0, 0, 1024, 512);
          ctx.fillStyle = '#334155';
          for (let i = 0; i < 120; i++) {
            ctx.beginPath();
            ctx.arc(Math.random() * 1024, 90 + Math.random() * 330, 25 + Math.random() * 70, 0, Math.PI * 2);
            ctx.fill();
          }
        } else if (mode === 'venus') {
          const grad = ctx.createLinearGradient(0, 0, 0, 512);
          grad.addColorStop(0, '#78350f');
          grad.addColorStop(0.5, '#f59e0b');
          grad.addColorStop(1, '#78350f');
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, 1024, 512);
          ctx.fillStyle = 'rgba(254, 243, 199, 0.2)';
          for (let i = 0; i < 40; i++) {
            ctx.fillRect(0, Math.random() * 512, 1024, 5 + Math.random() * 15);
          }
        }

        const texture = new THREE.CanvasTexture(canvas);
        const radius = 1.0;
        const globeMesh = new THREE.Mesh(new THREE.SphereGeometry(radius, 48, 48), new THREE.MeshStandardMaterial({ map: texture, roughness: 0.75 }));
        scene.add(globeMesh);

        // Atmosphere halo
        const atmosMat = new THREE.MeshBasicMaterial({
          color: mode === 'earth' ? 0x38bdf8 : mode === 'mars' ? 0xf97316 : mode === 'venus' ? 0xfbbf24 : 0x94a3b8,
          transparent: true,
          opacity: mode === 'moon' ? 0.05 : 0.2,
          side: THREE.BackSide
        });
        scene.add(new THREE.Mesh(new THREE.SphereGeometry(radius * 1.025, 32, 32), atmosMat));

        // Pins
        const pinsGroup = new THREE.Group();
        globeMesh.add(pinsGroup);

        const latLngToVector3 = (lat, lng, r) => {
          const phi = (90 - lat) * (Math.PI / 180);
          const theta = (lng + 180) * (Math.PI / 180);
          return new THREE.Vector3(-(r * Math.sin(phi) * Math.cos(theta)), r * Math.cos(phi), r * Math.sin(phi) * Math.sin(theta));
        };

        pins.forEach(pin => {
          const pos = latLngToVector3(pin.lat, pin.lng, radius * 1.01);
          const isSelected = pin.id === selectedPinId;
          const pinColor = isSelected ? 0x22d3ee : 0xf43f5e;
          const pinMesh = new THREE.Mesh(new THREE.SphereGeometry(0.026, 12, 12), new THREE.MeshBasicMaterial({ color: pinColor }));
          pinMesh.position.copy(pos);

          const ringMesh = new THREE.Mesh(new THREE.RingGeometry(0.03, 0.045, 24), new THREE.MeshBasicMaterial({ color: pinColor, side: THREE.DoubleSide, transparent: true, opacity: 0.8 }));
          ringMesh.position.copy(pos);
          ringMesh.lookAt(pos.clone().multiplyScalar(2));
          pinMesh.add(ringMesh);
          pinsGroup.add(pinMesh);
        });

        let animId;
        let isDragging = false;
        let prevMousePos = { x: 0, y: 0 };

        const animate = () => {
          animId = requestAnimationFrame(animate);
          if (autoRotate && !isDragging) globeMesh.rotation.y += 0.002;
          renderer.render(scene, camera);
        };
        animate();

        const onMouseDown = (e) => { isDragging = true; prevMousePos = { x: e.clientX, y: e.clientY }; };
        const onMouseMove = (e) => {
          if (isDragging) {
            globeMesh.rotation.y += (e.clientX - prevMousePos.x) * 0.005;
            globeMesh.rotation.x += (e.clientY - prevMousePos.y) * 0.005;
            prevMousePos = { x: e.clientX, y: e.clientY };
          }
        };
        const onMouseUp = () => { isDragging = false; };

        container.addEventListener('mousedown', onMouseDown);
        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);

        return () => {
          cancelAnimationFrame(animId);
          container.removeEventListener('mousedown', onMouseDown);
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
          renderer.dispose();
        };
      }, [mode, pins, selectedPinId, height]);

      return (
        <div className="relative w-full rounded-2xl overflow-hidden bg-slate-950/80 border border-cyan-500/20 shadow-2xl">
          <div ref={mountRef} className="w-full cursor-grab active:cursor-grabbing" style={{ height }} />
          <div className="absolute top-4 left-4 pointer-events-none flex items-center gap-2">
            <span className="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_#22d3ee]" />
            <span className="text-xs font-mono font-bold tracking-widest text-cyan-400 uppercase">3D TELEMETRY MATRIX // {mode.toUpperCase()}</span>
          </div>
          <div className="absolute bottom-4 right-4 flex items-center gap-2 bg-slate-900/80 p-1.5 rounded-xl border border-slate-700/60">
            <button onClick={() => setAutoRotate(!autoRotate)} className={`px-2.5 py-1 text-xs font-mono rounded-lg ${autoRotate ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40' : 'bg-slate-800 text-slate-400'}`}>
              {autoRotate ? 'ROTATING' : 'PAUSED'}
            </button>
          </div>
        </div>
      );
    }

